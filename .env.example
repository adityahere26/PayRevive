# payrevive — backend environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=4000

# --- Database ---
# MongoDB Atlas connection string (Test/dev cluster). Required at startup.
MONGODB_URI=

# --- Auth ---
# Secret used to sign/verify merchant JWTs. Required at startup. Use a long,
# random value in every real environment — never reuse this across deployments.
JWT_SECRET=

# --- Runtime AI provider (Google Gemini only — see CLAUDE.md § AI provider) ---
# Server-side only. Never prefix with VITE_ / expose to the frontend. Not required for the
# deterministic recovery pipeline; needed once the Gemini-backed voice/planner phase is wired
# into a live route. Uses the official @google/genai SDK — see server/src/ai/gemini/client.js.
GEMINI_API_KEY=

# --- Razorpay (Test Mode only) ---
# Server-side only — never exposed to the client. RAZORPAY_KEY_ID MUST start with rzp_test_;
# the server refuses to start with a rzp_live_ (or otherwise non-test-mode-shaped) key — see
# server/src/config/env.js and CLAUDE.md § Test Mode Only. Get Test Mode keys from the Razorpay
# Dashboard (Test Mode toggle) under Settings > API Keys. RAZORPAY_WEBHOOK_SECRET is the secret
# configured against the payment_link.paid / .expired / .cancelled webhook in the same dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- CORS ---
# The frontend origin allowed to call this API with credentials.
CLIENT_URL=http://localhost:5173

# --- Approval-gated autonomy ---
# When a failed-payment recovery case is created, immediately run it through the evaluate
# pipeline and record the decision as an item on the merchant's recovery plan. NO customer
# contact happens until the merchant confirms the plan (POST /api/recovery-plan/:id/confirm).
# On unless set to exactly "false". See ARCHITECTURE.md § Recovery plans.
RECOVERY_AUTOPLAN_ENABLED=true
