# payrevive — backend environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=development
PORT=4000

# --- Database ---
# MongoDB Atlas connection string (Test/dev cluster). Required at startup.
MONGODB_URI=

# --- Auth ---
# Secret used to sign/verify merchant JWTs. Required at startup. Use a long,
# random value in every real environment — never reuse this across deployments.
JWT_SECRET=

# --- Runtime AI provider (Google Gemini only — see CLAUDE.md § AI provider) ---
# Server-side only. Never prefix with VITE_ / expose to the frontend. Not required for the
# deterministic recovery pipeline; needed once the Gemini-backed voice/planner phase is wired
# into a live route. Uses the official @google/genai SDK — see server/src/ai/gemini/client.js.
GEMINI_API_KEY=

# --- Razorpay (Test Mode only) ---
# Not required for the Day 2 foundation; needed starting Day 4 (payment links/webhooks).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- CORS ---
# The frontend origin allowed to call this API with credentials.
CLIENT_URL=http://localhost:5173
